<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderMast Network - Affiliate Traffic Portal</title>
    <style>
        :root {
            --primary-color: #0d6efd;
            --bg-color: #f8f9fa;
            --text-color: #212529;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            text-align: center;
            padding: 2rem;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .btn-offer {
            display: inline-block;
            background-color: var(--primary-color);
            color: white;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
            margin-top: 15px;
            transition: background 0.3s;
        }
        .btn-offer:hover {
            background-color: #0b5ed7;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Exclusive Offer Access</h1>
        <p>You are being safely routed to the best available offer for your region.</p>
        
        <!-- Replace 'YOUR_SMARTLINK_URL' with your actual WanderMast affiliate tracker link -->
        <a href="https://wandermast.com" class="btn-offer" id="offerLink">
            Proceed to Offer
        </a>
    </div>

    <script>
        // Optional Auto-Redirection logic for Smartlinks
        document.addEventListener("DOMContentLoaded", function() {
            const autoRedirect = false; // Set to true if you want instant routing
            if (autoRedirect) {
                const targetUrl = document.getElementById('offerLink').getAttribute('href');
                window.location.href = targetUrl;
            }
        });
    </script>
</body>
</html>
